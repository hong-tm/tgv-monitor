# Local credential file (plaintext secrets; never commit)
.env

# Subscription state (runtime artifact, contains personal viewing data; not tracked)
subscriptions.json
subscriptions.json.bak
subscriptions.json.tmp
subscriptions.json.corrupt-*

# Dependencies and indexes (local artifacts)
# no trailing slash: a worktree may symlink node_modules, and `node_modules/` only matches directories
node_modules
.codegraph/

# Agent-tool runtime state (omo session resume markers etc.); not tracked
.omo/
