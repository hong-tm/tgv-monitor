{
  "$schema": "https://opencode.ai/config.json",
  // Enable snapshot for this project only. Keep the global ~/.config/opencode/opencode.jsonc at false:
  // with cwd=/root, snapshot would scan the whole /root worktree and peg the CPU into OOM.
  // Snapshot scope is the session directory (git commands run with cwd=session dir + pathspec ".").
  // Measured on this project: 7 untracked/modified files. Note: tgv-monitor and /root share one git root,
  // snapshot repos are shared per worktree, so a rollback could in theory rewrite /root repo tracked files too.
  "snapshot": true
}
