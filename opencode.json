{
  "$schema": "https://opencode.ai/config.json",
  // 只给本项目开 snapshot。全局 ~/.config/opencode/opencode.jsonc 保持 false：
  // opencode 以 cwd=/root 跑时 snapshot 会扫整个 /root 工作树，CPU 打满并 OOM。
  // snapshot 的扫描范围是会话目录（git 命令用 cwd=会话目录 + pathspec "."），
  // 本项目实测 7 个未跟踪/已改文件。注意：tgv-monitor 与 /root 同属一个 git 根，
  // snapshot 仓库按 worktree 共享，回滚时理论上会连带重写 /root 仓库的 tracked 文件。
  "snapshot": true
}
